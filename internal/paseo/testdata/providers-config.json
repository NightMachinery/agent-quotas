{"agents": {"providers": {
  "claude": {"label": "Claude", "env": {"BASE_ONLY": "b"}, "extra": 1.50},
  "claude-work": {"extends": "claude", "label": "Work", "env": {"CLAUDE_CONFIG_DIR": "~/.claude-work"}, "model": "claude-opus-5-5"},
  "claude-work-alias": {"extends": "claude-work", "label": "Alias", "env": {"X_FLAG": "1"}, "args": ["--x", 2, null, true]},
  "claude-explicit-default": {"extends": "claude", "env": {"CLAUDE_CONFIG_DIR": "~/.claude"}},
  "codex-work": {"extends": "codex", "label": "Work", "env": {"CODEX_HOME": "/tmp/example-codex-work"}},
  "codex-nested": {"extends": "codex-work", "env": {"CODEX_HOME": "/tmp/example-codex-nested", "DEPTH": 2}, "flags": {"b": [1.0, 2e-7], "a": "é"}},
  "codex-unicode": {"extends": "codex", "label": "Über", "env": {"NOTE": "’😀"}, "n": 12345678901234567890},
  "cycle-a": {"extends": "cycle-b"},
  "cycle-b": {"extends": "cycle-a"},
  "agy-acp": {"extends": "acp", "command": ["/x/bin/agy", "acp"], "env": {"AGY_ACCOUNT_ID": "cave"}},
  "agy-main": {"extends": "acp", "command": ["/x/bin/agy"], "env": {"AGY_ACCOUNT_ID": "acc1"}},
  "agy-child": {"extends": "agy-acp", "command": ["/x/bin/other"], "env": {"AGY_ACCOUNT_ID": "dune"}},
  "other-acp": {"extends": "acp", "command": ["/x/bin/gemini"]}
}}}
